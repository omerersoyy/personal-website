---
/**
 * FoldCard — the 17° rule as a box (00-FOUNDATION.md §6). Top and bottom
 * edges break at the centre and fall outward. `--fold-rise` is constant, so
 * the slope softens on wide cards; that is intended.
 *
 * Renders as <a> when `href` is given.
 */
interface Props {
  as?: "div" | "article" | "li" | "section";
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { as = "div", href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : as;
---

<Tag class:list={["fold-card", { "is-link": !!href }, className]} href={href} {...rest}>
  <slot />
</Tag>

<style>
  .fold-card {
    --rise: var(--fold-rise);
    display: block;
    background: var(--c-surface);
    padding: calc(var(--s-6) + var(--rise)) var(--s-6);
    clip-path: polygon(
      0 var(--rise),
      50% 0,
      100% var(--rise),
      100% calc(100% - var(--rise)),
      50% 100%,
      0 calc(100% - var(--rise))
    );
  }

  .fold-card.is-link {
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .fold-card.is-link:hover {
    background: var(--c-surface-2);
    color: inherit;
    transform: translateY(-2px);
  }

  /* clip-path swallows the outline ring, so focus is drawn inside the shape. */
  .fold-card.is-link:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--c-accent);
  }
</style>
