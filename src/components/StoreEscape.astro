---
/**
 * StoreEscape — the notice shown when /play is opened inside an app's own
 * browser (Instagram, TikTok, Facebook…).
 *
 * Those webviews cannot hand an App Store link to the App Store: on iOS
 * apps.apple.com redirects to itms-appss://, which an in-app browser is not
 * permitted to open, so the tap silently does nothing. A link shortener does
 * not help — the redirect ends up in the same webview.
 *
 * scripts/store-escape.js tries the best native route it can, and only unhides
 * this when that route is seen to have failed — the page is still in the
 * foreground a beat after the tap. Showing it on arrival, as it did until
 * 2026-09, greets every visitor with "this probably will not work" before they
 * have tried anything, which is a bad trade for a route that usually works.
 * Once shown it stays: the visitor is now looking at the only thing that helps.
 *
 * Rendered hidden, so it costs nothing in a normal browser and never flashes.
 */
---

<p class="escape" data-store-escape hidden>
  <span class="mark" aria-hidden="true">!</span>
  <span>
    Instagram’s browser can block store links.
    <b data-store-escape-how>Open this page in your browser.</b>
  </span>
</p>

<script src="../scripts/store-escape.js"></script>

<style>
  /* `display: flex` below outranks the user agent's `[hidden] { display: none }`,
     so without this the attribute does nothing and the notice shows to every
     visitor in every browser — which is exactly what happened. */
  .escape[hidden] {
    display: none;
  }

  .escape {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-mist);
    font-size: var(--t-small);
    line-height: 1.5;
    text-align: left;
  }

  .escape b {
    display: block;
    color: var(--c-paper);
    font-weight: 500;
  }

  .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--c-green);
    color: var(--c-ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
  }
</style>
