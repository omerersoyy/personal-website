---
/**
 * StoreBadges — official App Store / Google Play badges from public/badges/.
 * Renders nothing when neither URL is given.
 *
 * The official badge artwork cannot be redistributed here; it is downloaded
 * from Apple and Google (see public/badges/README.md). Until a badge file is
 * present the link renders as a plain text button, so the page is never
 * broken and never shows a fake badge. Existence is checked at build time.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  appStore?: string;
  playStore?: string;
  /** Badge height in px. Minimum 44 keeps the touch target legal on /play. */
  height?: number;
  /**
   * Row alignment. "start" next to prose, where the badges are one more thing
   * in a left-aligned column; "center" on /play, where the card is a standalone
   * door and a left-hugging row leaves an obvious hole on the right.
   */
  align?: "start" | "center";
  /**
   * Let the badges span the full row once they no longer fit side by side.
   * Only worth it where the badges are the point of the card (/play): stacked
   * at their natural ~132px they sit marooned in the middle of a phone screen.
   */
  fill?: boolean;
  class?: string;
}

const {
  appStore,
  playStore,
  height = 44,
  align = "start",
  fill = false,
  class: className,
} = Astro.props;

// Resolved from the project root, not from import.meta.url: in a production
// build this module's URL points into Vite's output, so "../../public" walked
// somewhere that does not exist and every badge silently fell back to the text
// button — which is exactly what shipped once the real artwork was added.
const badgeDir = join(process.cwd(), "public", "badges");
const hasBadge = (file: string) => existsSync(join(badgeDir, file));

// Store identifiers pulled out of the URLs, so the escape hatch in
// scripts/store-escape.js can rebuild a native-scheme link without the id being
// written down twice. See StoreEscape.astro for why that is needed at all.
const appId = appStore?.match(/\/id(\d+)/)?.[1];
const pkg = playStore?.match(/[?&]id=([\w.]+)/)?.[1];

const stores = [
  {
    url: appStore,
    file: "app-store.svg",
    label: "Download on the App Store",
    text: "App Store",
    store: "apple",
    ref: appId,
  },
  {
    url: playStore,
    file: "google-play.png",
    label: "Get it on Google Play",
    text: "Google Play",
    store: "google",
    ref: pkg,
  },
].filter((s) => !!s.url);
---

{
  stores.length > 0 && (
    <div
      class:list={["badges", { "badges-fill": fill }, className]}
      style={`--badge-h:${height}px;--badge-align:${align === "center" ? "center" : "flex-start"}`}
    >
      {stores.map((store) =>
        hasBadge(store.file) ? (
          <a
            href={store.url}
            class="badge"
            data-store={store.store}
            data-store-ref={store.ref}
          >
            <img
              src={`/badges/${store.file}`}
              alt={store.label}
              height={height}
              loading="lazy"
            />
          </a>
        ) : (
          <a
            href={store.url}
            class="badge badge-text"
            data-store={store.store}
            data-store-ref={store.ref}
          >
            {store.text}
          </a>
        ),
      )}
    </div>
  )
}

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    /* Row gap / column gap. The badges are ~132px and ~148px wide, so a 12px
       column gap disappeared against them entirely; 32 reads as deliberate and
       still leaves ~48px either side of a centred row in a 360px card. They
       stack below ~380px — 132 + 148 + 32 does not fit — and stacked they want
       a tighter 16, not the same 32. */
    gap: var(--s-4) var(--s-8);
    align-items: center;
    justify-content: var(--badge-align, flex-start);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: var(--badge-h);
    text-decoration: none;
  }

  /* Both files are edge to edge — google-play.png is 478×142 with no padding
     inside it, app-store.svg is 119.66×40 — so one shared height is already
     the correct optical match. Do not "compensate" one against the other. */
  .badge img {
    height: var(--badge-h);
    width: auto;
  }

  .badge-text {
    padding-inline: var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    color: var(--c-paper);
    font-size: var(--t-small);
    transition: border-color 0.15s ease;
  }

  .badge-text:hover {
    border-color: var(--c-accent);
    color: var(--c-paper);
  }

  /* Below this width the two badges cannot share a row: the /play card gives
     them viewport − 32 (page padding) − 48 (card padding), and side by side
     they need 132 + 148 + 32 = 312. So 392 is where they start stacking, and
     stacked is where full width earns its keep.

     Equal width, not equal height: the artwork's aspect ratios differ (2.99 vs
     3.37), so one of the two has to give. Stacked, the eye follows the left and
     right edges — matching those and letting the heights differ by ~10px reads
     far better than the reverse. */
  @media (max-width: 391px) {
    .badges-fill {
      flex-direction: column;
      align-items: stretch;
    }

    .badges-fill .badge {
      width: 100%;
      justify-content: center;
    }

    .badges-fill .badge img {
      width: 100%;
      height: auto;
    }
  }
</style>
