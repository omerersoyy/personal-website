---
/**
 * GameCard — cover, title, tagline, status badge, store badges.
 *
 * The whole card links to /games/<slug>, but the card is NOT an <a>: it also
 * contains store links, and nested anchors are invalid — the parser closes the
 * outer one and the badges escape the card entirely. Instead the title is the
 * real link and a stretched ::after covers the card, with the badges lifted
 * above it so they stay clickable.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import FoldCard from "./FoldCard.astro";
import StoreBadges from "./StoreBadges.astro";

interface Props {
  game: CollectionEntry<"games">;
}

const { game } = Astro.props;
const { title, tagline, status, cover, appStoreUrl, playStoreUrl, accent } =
  game.data;

const statusLabel =
  status === "live" ? "Out now" : status === "soon" ? "Coming soon" : "In development";
---

<FoldCard as="article" class="game-card">
  <Image
    class="cover"
    src={cover}
    alt={`${title} cover art`}
    width={560}
    height={560}
    densities={[1, 2]}
    loading="lazy"
    style={accent ? `background-color:${accent}` : undefined}
  />
  <div class="body">
    <div class="head">
      <h3>
        <a class="title-link" href={`/games/${game.id}`}>{title}</a>
      </h3>
      <span class:list={["status", status]}>{statusLabel}</span>
    </div>
    <p class="tagline">{tagline}</p>
  </div>
  {
    status === "live" && (
      <div class="stores">
        <StoreBadges appStore={appStoreUrl} playStore={playStoreUrl} height={40} />
      </div>
    )
  }
</FoldCard>

<style>
  .game-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .game-card:hover {
    background: var(--c-surface-2);
    transform: translateY(-2px);
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  /* The card-wide hit area. Sits under the store badges, which are lifted. */
  .title-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .title-link:focus-visible {
    outline: none;
  }

  .game-card:has(.title-link:focus-visible) {
    box-shadow: inset 0 0 0 2px var(--c-accent);
  }

  .stores {
    position: relative;
    z-index: 1;
  }

  /* The art is portrait phone capture. Cropping to square from the centre
     loses the part that reads; the top of a screenshot is where the mechanic
     is visible. */
  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius);
    background: var(--c-surface-2);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .tagline {
    color: var(--c-mist);
    font-size: var(--t-small);
    margin-top: var(--s-2);
  }

  /* Green is a surface, never a text colour (§5). */
  .status {
    flex: none;
    font-family: var(--f-mono);
    font-size: var(--t-small);
    line-height: 1;
    padding: var(--s-1) var(--s-2);
    border-radius: var(--radius);
    border: 1px solid var(--c-line);
    color: var(--c-mist);
  }

  .status.live {
    background: var(--c-green);
    border-color: var(--c-green);
    color: var(--c-ink);
  }
</style>
