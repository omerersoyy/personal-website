---
/**
 * 404 — short, and points at the two things a lost visitor probably wanted.
 */
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Tesser" noindex>
  <div class="wrap section notfound">
    <p class="mono">404</p>
    <h1>There's nothing on the other side of this one.</h1>
    <p class="links">
      <a href="/">Home</a> · <a href="/play">Games</a> · <a href="/support">Support</a>
    </p>
  </div>
</Base>

<style>
  .notfound {
    min-height: 52svh;
    display: grid;
    align-content: center;
  }

  h1 {
    margin-top: var(--s-4);
    max-width: 22ch;
  }

  .links {
    margin-top: var(--s-8);
    font-size: var(--t-small);
  }
</style>
