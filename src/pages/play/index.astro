---
/**
 * /play — the link-in-bio page (01-PAGES.md §4).
 *
 * This is the URL in every social bio. It is opened almost entirely on phones
 * from a bio tap, so every store button has to be reachable without scrolling
 * on a 375×667 screen.
 *
 * 2026-09 (owner): "not enticing enough". Still a door, but a lit one:
 *   - the first card plays its game's loop across its top (PlayCard `featured`);
 *   - each card shows ONE badge, the visitor's store, big, with the other store
 *     as a text link — known from the user agent before first paint (below);
 *     desktop / unknown / no-JS keep both badges;
 *   - inout parkour's blob runs the cards' outer edges (BlobActor).
 */
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Lockup from "../../components/Lockup.astro";
import PlayCard from "../../components/PlayCard.astro";
import StoreEscape from "../../components/StoreEscape.astro";
import BlobActor from "../../components/BlobActor.astro";

// Live games only. A card that cannot be installed is dead weight on a page
// whose whole job is to hand out store links — and worse when the page is the
// destination of a paid ad, where the visitor arrived expecting to download
// something. Unreleased games keep their own /games/[slug] page and are still
// reachable at /play/[slug]; `order` still decides the sort, so a game shows up
// here in its intended position the moment its status flips to "live".
const games = (await getCollection("games"))
  .filter((game) => game.data.status === "live")
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Play Tesser games" noindex chrome={false}>
  <!-- The visitor's platform, set before first paint so the page never shows
       two badges and then drops one. Same test as scripts/store-escape.js
       (iPadOS reports itself as a Mac with touch). -->
  <script is:inline slot="head">
    (function () {
      var u = navigator.userAgent || "";
      var h = document.documentElement.classList;
      if (/iPhone|iPad|iPod/.test(u) || (/Macintosh/.test(u) && navigator.maxTouchPoints > 1)) h.add("os-ios");
      else if (/Android/i.test(u)) h.add("os-android");
    })();
  </script>

  <div class="play">
    <a href="/" class="top" aria-label="Tesser — home">
      <Lockup variant="horizontal" size={24} />
    </a>

    <!-- The page is a list of doors; the heading exists for structure, not
         decoration, so it is announced but not drawn. -->
    <h1 class="visually-hidden">Play Tesser games</h1>

    <StoreEscape />

    <ul class="list">
      {games.map((game, i) => <PlayCard game={game} featured={i === 0} />)}
    </ul>

    <a href="/" class="back">tessergames.com</a>
  </div>

  <BlobActor />
</Base>

<style>
  .play {
    min-height: 100svh;
    max-width: 440px;
    margin-inline: auto;
    padding: var(--s-4) var(--s-4) var(--s-8);
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--s-4);
  }

  .top {
    display: inline-flex;
    text-decoration: none;
  }

  .list {
    width: 100%;
    display: grid;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .back {
    font-family: var(--f-mono);
    font-size: var(--t-small);
    color: var(--c-mist);
    text-decoration: none;
  }

  .back:hover {
    color: var(--c-accent);
  }
</style>
