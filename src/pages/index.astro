---
/**
 * Home — placeholder for the foundation phase. Structure follows 01-PAGES §3
 * so the components are exercised end to end; the real copy, loop videos and
 * covers land with the pages phase.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FoldReveal from "../components/FoldReveal.astro";
import Tunnel from "../components/Tunnel.astro";
import BlobActor from "../components/BlobActor.astro";
import GameCard from "../components/GameCard.astro";
import TesseraGrid from "../components/TesseraGrid.astro";
import SectionRule from "../components/SectionRule.astro";
import { SITE, SOCIAL } from "../site";

const games = (await getCollection("games")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Organization schema, home page only (02-MIGRATION-LAUNCH.md §5).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/press/mark-1024.png`,
  email: SITE.support,
  sameAs: SOCIAL.map((s) => s.href),
};
---

<Base title="Tesser — small games built around one strange mechanic">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <section class="wrap section hero-wrap">
    <FoldReveal>
      <!-- Behind the wall: Beaster's corridor, seen from inside it. -->
      <div slot="bottom" class="stage" aria-hidden="true">
        <Tunnel />
      </div>

      <!-- The wall. Empty: everything readable lives in the layer above, so
           the hole erases the wall and not the words. -->
      <div slot="top" class="wall"></div>

      <!-- The blob's first platform is the aperture itself: it runs the rim of
           the hole until the pointer arrives, then bolts into the page. This
           element is invisible and exists only to give the blob the hole's
           geometry — the hole is a mask, and a mask has no rect to walk.

           It is only ever a starting perch (`start`), never a jump target: the
           aperture moves with the pointer while this rect does not, so coming
           back to it would mean orbiting nothing. -->
      <div slot="over" class="over-stack">
        <div class="aperture-box" data-blob-box="start" aria-hidden="true"></div>
        <div class="hero">
          <div class="above"></div>
          <div class="void" aria-hidden="true"></div>
          <div class="below"></div>
        </div>
      </div>

      <!-- The headline is found, not presented: on desktop it exists only
           inside the hole. Same grid as the layer above, so the two stay in
           register. On touch it is simply visible. -->
      <div slot="reveal" class="hero">
        <div class="above"></div>
        <div class="void" aria-hidden="true"></div>
        <div class="below">
          <h1>Small games built around one strange mechanic.</h1>
        </div>
      </div>
    </FoldReveal>
  </section>

  <section class="wrap section" id="games">
    <h2>Games</h2>
    <TesseraGrid class="games">
      {games.map((game) => <GameCard game={game} />)}
    </TesseraGrid>
  </section>

  <div class="wrap"><SectionRule /></div>

  <section class="wrap section">
    <div class="measure">
      <h2>Approach</h2>
      <p>
        Every Tesser game starts with one question: what if you could get to the
        other side of a wall without walking around it?
      </p>
      <p>
        The games are small on purpose. One mechanic, explored properly, is more
        interesting than five mechanics stacked on top of each other.
      </p>
    </div>
  </section>

  <BlobActor />
</Base>

<style>
  .hero-wrap {
    padding-top: var(--s-8);
  }

  /* The hole rests at the centre of the hero, so the centre is a row of its
     own. Equal 1fr rides above and below guarantee that row is exactly
     centred whatever the content heights, which is what keeps the headline
     out of the mask instead of hoping it clears. */
  .hero {
    display: grid;
    grid-template-rows: 1fr var(--reveal-void) 1fr;
    justify-items: center;
    min-height: 78svh;
  }

  .above {
    align-self: end;
    padding-bottom: var(--s-6);
  }

  .below {
    align-self: start;
    padding-top: var(--s-6);
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }

  .wall {
    height: 100%;
  }

  .hero h1 {
    font-size: var(--t-hero);
    max-width: 20ch;
  }

  .stage {
    height: 100%;
    overflow: hidden;
  }

  .over-stack {
    display: contents;
  }

  /* A box for the blob to live on, and the only piece of the hero that is
     drawn ON the wall rather than behind it. Sized so the perimeter walk is
     long enough to read as a walk, small enough to stay out of the way. */
  /* The aperture's own rectangle, at rest. Never painted — the hole is already
     drawn by the mask; this only carries its geometry so the blob has a rim to
     run. The numbers come from the aperture artwork: it is 248 × 257 with the
     card sitting 200 × 209 in the middle of it, so the card is 0.806 of the
     mask's width and 0.8425 of it in height. */
  .aperture-box {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--r) * 0.806);
    height: calc(var(--r) * 0.8425);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  /* No aperture on touch, so no rim to run: without this the blob would orbit
     an invisible rectangle in the middle of the hero. */
  @media (max-width: 639px), (pointer: coarse) {
    .aperture-box {
      display: none;
    }
  }

  @media (max-width: 639px), (pointer: coarse) {
    .hero h1 {
      max-width: 16ch;
      text-align: center;
    }
  }

  .games {
    margin-top: var(--s-8);
  }

  .measure > * + * {
    margin-top: var(--s-4);
  }

  .measure h2 {
    margin-bottom: var(--s-6);
  }
</style>
