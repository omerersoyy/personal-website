---
/**
 * Home — placeholder for the foundation phase. Structure follows 01-PAGES §3
 * so the components are exercised end to end; the real copy, loop videos and
 * covers land with the pages phase.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import FoldReveal from "../components/FoldReveal.astro";
import Lockup from "../components/Lockup.astro";
import GameCard from "../components/GameCard.astro";
import TesseraGrid from "../components/TesseraGrid.astro";
import SectionRule from "../components/SectionRule.astro";
import { SITE, SOCIAL } from "../site";

const games = (await getCollection("games")).sort(
  (a, b) => a.data.order - b.data.order,
);

// One tile per game, centred behind the wall. Repeating them to fill the
// width turns the hero into wallpaper.
const tiles = games.map((game) => game.data.cover);

// Organization schema, home page only (02-MIGRATION-LAUNCH.md §5).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/press/mark-1024.png`,
  email: SITE.support,
  sameAs: SOCIAL.map((s) => s.href),
};
---

<Base title="Tesser — small games built around one strange mechanic">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <section class="wrap section hero-wrap">
    <FoldReveal>
      <!-- TODO: the games' loop videos replace these tiles.
           Square tiles, cropped from the top — the same framing as the game
           cards. Full-height stretching blows the games' own HUD up to the
           size of the page, which reads as interface rather than motion. -->
      <div slot="bottom" class="mosaic" aria-hidden="true">
        {
          tiles.map((cover) => (
            <Image src={cover} alt="" width={420} height={420} densities={[1, 2]} loading="eager" />
          ))
        }
      </div>

      <!-- The wall. Empty: everything readable lives in the layer above, so
           the hole erases the wall and not the words. -->
      <div slot="top" class="wall"></div>

      <!-- The lockup is always there. -->
      <div slot="over" class="hero">
        <div class="above">
          <Lockup variant="stacked" size={96} label="Tesser" />
        </div>
        <div class="void" aria-hidden="true"></div>
        <div class="below"></div>
      </div>

      <!-- The headline is found, not presented: on desktop it exists only
           inside the hole. Same grid as the layer above, so the two stay in
           register. On touch it is simply visible. -->
      <div slot="reveal" class="hero">
        <div class="above"></div>
        <div class="void" aria-hidden="true"></div>
        <div class="below">
          <h1>Small games built around one strange mechanic.</h1>
        </div>
      </div>
    </FoldReveal>
  </section>

  <section class="wrap section" id="games">
    <h2>Games</h2>
    <TesseraGrid class="games">
      {games.map((game) => <GameCard game={game} />)}
    </TesseraGrid>
  </section>

  <div class="wrap"><SectionRule /></div>

  <section class="wrap section">
    <div class="measure">
      <h2>Approach</h2>
      <p>
        Every Tesser game starts with one question: what if you could get to the
        other side of a wall without walking around it?
      </p>
      <p>
        The games are small on purpose. One mechanic, explored properly, is more
        interesting than five mechanics stacked on top of each other.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero-wrap {
    padding-top: var(--s-8);
  }

  /* The hole rests at the centre of the hero, so the centre is a row of its
     own. Equal 1fr rides above and below guarantee that row is exactly
     centred whatever the content heights, which is what keeps the headline
     out of the mask instead of hoping it clears. */
  .hero {
    display: grid;
    grid-template-rows: 1fr var(--reveal-void) 1fr;
    justify-items: center;
    min-height: 78svh;
  }

  .above {
    align-self: end;
    padding-bottom: var(--s-6);
  }

  .below {
    align-self: start;
    padding-top: var(--s-6);
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }

  .wall {
    height: 100%;
  }

  .hero h1 {
    font-size: var(--t-hero);
    max-width: 20ch;
  }

  .mosaic {
    display: grid;
    grid-auto-flow: column;
    justify-content: center;
    align-content: center;
    gap: var(--s-4);
    height: 100%;
    overflow: hidden;
  }

  .mosaic img {
    width: clamp(180px, 26vw, 340px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius);
  }

  .games {
    margin-top: var(--s-8);
  }

  .measure > * + * {
    margin-top: var(--s-4);
  }

  .measure h2 {
    margin-bottom: var(--s-6);
  }
</style>
